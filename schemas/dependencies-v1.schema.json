{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Skills Exchange dependency profile v1 (draft, packaged)",
  "description": "Companion to a standard Agent Skills package. Structural validation is not dependency resolution, admission or permission to install.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "features", "platforms", "hosts", "software", "skills", "network", "credentials", "lockfiles"],
  "properties": {
    "schema_version": {"const": 1},
    "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "platforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/platform"}},
    "hosts": {"type": "array", "items": {"$ref": "#/$defs/host"}},
    "software": {"type": "array", "items": {"$ref": "#/$defs/software"}},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "network": {"type": "array", "items": {"$ref": "#/$defs/network"}},
    "credentials": {"type": "array", "items": {"$ref": "#/$defs/credential"}},
    "lockfiles": {"type": "array", "items": {"$ref": "#/$defs/lockfile"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)(?![A-Za-z]:).+$"},
    "https": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
    "applies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "platform_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "version": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "constraint"],
      "properties": {
        "scheme": {"enum": ["exact", "semver", "pep440", "system", "none"]},
        "constraint": {"type": "string"}
      },
      "if": {"properties": {"scheme": {"const": "none"}}},
      "then": {"properties": {"constraint": {"const": ""}}},
      "else": {"properties": {"constraint": {"$ref": "#/$defs/text"}}}
    },
    "support": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["declared", "tested"]},
        "evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}
      },
      "if": {"properties": {"status": {"const": "tested"}}},
      "then": {"properties": {"evidence": {"minItems": 1}}}
    },
    "platform": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "os", "distribution", "version", "architectures", "applies_to", "support"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "os": {"enum": ["linux", "macos", "windows", "freebsd", "any"]},
        "distribution": {"$ref": "#/$defs/text"},
        "version": {"$ref": "#/$defs/version"},
        "architectures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}},
        "applies_to": {"$ref": "#/$defs/applies"},
        "support": {"$ref": "#/$defs/support"}
      }
    },
    "host": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "required", "applies_to", "support"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"},
        "required": {"type": "boolean"}, "applies_to": {"$ref": "#/$defs/applies"},
        "support": {"$ref": "#/$defs/support"}
      }
    },
    "installation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "package", "source", "instructions"],
      "properties": {
        "method": {"enum": ["system-package", "package-manager", "container", "manual", "preinstalled"]},
        "package": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/https"},
        "instructions": {"$ref": "#/$defs/path"}
      }
    },
    "software": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "version", "required", "applies_to", "platforms", "installation"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["runtime", "tool", "library", "os-package", "service"]},
        "version": {"$ref": "#/$defs/version"}, "required": {"type": "boolean"},
        "applies_to": {"$ref": "#/$defs/applies"}, "platforms": {"$ref": "#/$defs/platform_refs"},
        "installation": {"$ref": "#/$defs/installation"}
      }
    },
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "revision", "path", "package_sha256", "required", "applies_to", "features"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/https"},
        "revision": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
        "path": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/path"}]},
        "package_sha256": {"$ref": "#/$defs/digest"},
        "required": {"type": "boolean"}, "applies_to": {"$ref": "#/$defs/applies"},
        "features": {"$ref": "#/$defs/applies"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "destination", "purpose", "required", "applies_to"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "destination": {"type": "string", "pattern": "^(?:https?|wss?|tcp|udp)://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
        "purpose": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"},
        "applies_to": {"$ref": "#/$defs/applies"}
      }
    },
    "credential": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose", "permissions", "provisioning", "required", "applies_to"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "purpose": {"$ref": "#/$defs/text"},
        "permissions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "provisioning": {"$ref": "#/$defs/path"}, "required": {"type": "boolean"},
        "applies_to": {"$ref": "#/$defs/applies"}
      }
    },
    "lockfile": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "format", "applies_to"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/digest"},
        "format": {"$ref": "#/$defs/text"}, "applies_to": {"$ref": "#/$defs/applies"}
      }
    }
  }
}
